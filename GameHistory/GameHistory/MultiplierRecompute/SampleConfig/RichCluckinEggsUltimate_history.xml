<?xml version="1.0" encoding="utf-8"?>
<!--
  *** INTENTIONALLY WRONG — NEGATIVE TEST ONLY ***

  RichCluckinEggs multipliers actually use the LINE-BET TOTAL as their base (base = 5.0 on the
  sample round, where total bet = 7.50). This config deliberately uses the TotalBet strategy so the
  computed values are wrong on purpose, to prove the validator's WARN path fires.

  Expected on the sample round (total bet = 7.50, so base is wrongly taken as 7.50):
    computed  B01 -> 7.50,  B05 -> 37.50
    recorded located-scatter wins -> 5.00 and 25.00 (base = 5.0: 5x1 and 5x5)
    => neither matches => WARN "recorded located-scatter win 5.00/25.00 has no matching computed value"
       plus DEBUG "computed B01=7.50 / B05=37.50 has no matching recorded win".

  RUNTIME LOCATION (to run the test): copy to
    C:\inetpub\wwwroot\GameConfig\RichCluckinEggsUltimate\RichCluckinEggsUltimate_history.xml
  Delete it again afterwards so it doesn't mislead a real run.

  (Wd wild multipliers exist for this game but fold into payline wins, so Phase 1 does not validate
   them; they are omitted here to keep the test output focused on located scatters.)
-->
<GameHistoryConfig gameName="RichCluckinEggsUltimate">
  <multiplierGroups>
    <group name="LocatedScatter" strategy="TotalBet">
      <symbol name="B01"  value="1"   paid="true" />
      <symbol name="B02"  value="2"   paid="true" />
      <symbol name="B03"  value="3"   paid="true" />
      <symbol name="B05"  value="5"   paid="true" />
      <symbol name="B10"  value="10"  paid="true" />
      <symbol name="B25"  value="25"  paid="true" />
      <symbol name="B50"  value="50"  paid="true" />
      <symbol name="B100" value="100" paid="true" />
    </group>
  </multiplierGroups>
</GameHistoryConfig>
