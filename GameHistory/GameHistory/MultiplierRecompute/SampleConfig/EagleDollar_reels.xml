<?xml version="1.0" encoding="utf-8"?>
<AgtReelConfig>
  <agtReels>
    <agtReel name="reel1" row="0" column="0" />
    <agtReel name="reel2" row="0" column="1" />
    <agtReel name="reel3" row="0" column="2" />
    <agtReel name="reel4" row="0" column="3" />
    <agtReel name="reel5" row="0" column="4" />
    <agtReel name="reel6a" row="0" column="5" />
    <agtReel name="reel6b" row="1" column="5" />
    <agtReel name="reel6c" row="2" column="5" />
  </agtReels>
	<GameHistoryConfig gameName="EagleDollar">
		<multiplierGroups>
			<!-- The wheel result (visible reel 5) is the single overlay target. The TotalScatterWin strategy
			     reads the finalised amount straight from the recorded located-scatter win, so it handles both
			     the base x wheel multiplier spins AND the fixed jackpot spins (Mini/Minor/Major/Grand)
			     uniformly, and shows nothing when only a payline paid.
			     value = the wheel multiplier (Wh=x1 .. Wh5=x5). It is documentation only — TotalScatterWin
			     does not use it — but it keeps a consistent symbol-to-multiplier mapping. -->
			<group name="WheelResult" strategy="TotalScatterWin" paid="true">
				<symbol name="Wh"  value="1"/>
				<symbol name="Wh2" value="2"/>
				<symbol name="Wh3" value="3"/>
				<symbol name="Wh4" value="4"/>
				<symbol name="Wh5" value="5"/>
			</group>
		</multiplierGroups>
	</GameHistoryConfig>
</AgtReelConfig>