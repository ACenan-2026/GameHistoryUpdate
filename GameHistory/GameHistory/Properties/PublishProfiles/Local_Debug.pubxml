<?xml version="1.0" encoding="utf-8"?>
<!--
  FileSystem publish profile for the LOCAL IIS TEST ENVIRONMENT.

  Compiles the GameHistory web app (Debug) and copies the runtime files
  (bin\*.dll, Views, Content, Web.config with the Debug transform applied,
  Global.asax, jquery, CurrencyCode.xml) into:

      C:\inetpub\wwwroot\GameHistory

  Use it either way:
    - Visual Studio: right-click the GameHistory project > Publish > Local_Debug
    - Command line / automation: run  deploy-local.ps1  in the repo root

  DeleteExistingFiles is False so runtime-generated files in the target
  (e.g. log4net logs) are preserved. Set it to True if you want each publish
  to start from a clean folder.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <LastUsedBuildConfiguration>Debug</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <ExcludeApp_Data>True</ExcludeApp_Data>
    <!--
      Destination = your local IIS site folder. Precedence:
        1. /p:publishUrl=<path>  passed on the MSBuild command line
        2. env var  GameHistoryDeployPath=<path>  (also honored by the VS Publish button)
        3. the default below (the standard IIS root)
      So a teammate whose IIS site lives elsewhere can override it WITHOUT
      editing this shared, committed file.
    -->
    <publishUrl Condition="'$(publishUrl)' == ''">$(GameHistoryDeployPath)</publishUrl>
    <publishUrl Condition="'$(publishUrl)' == ''">C:\inetpub\wwwroot\GameHistory</publishUrl>
    <DeleteExistingFiles>False</DeleteExistingFiles>
  </PropertyGroup>
</Project>
