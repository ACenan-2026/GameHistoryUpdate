 @{
     var grid = new WebGrid(Model.UserPositions.SlotUsersPositionsAndDetails.SlotDetails.SlotDetails, canSort:false, canPage: false);

    @grid.GetHtml(tableStyle: "webGrid",
            headerStyle: "header-style",
            rowStyle: "row-style",
            alternatingRowStyle: "alt",
            selectedRowStyle: "select",
            emptyRowCellValue: "N/A",
            columns: grid.Columns(
            grid.Column("Total Bet", format: (item) => Html.Raw(item.BetDetail), style: "betWinColumn"),
            grid.Column("Won", "Win", style:"betWinColumn"),
            grid.Column("Wins", format: (item) => Html.Raw(item.WinDetails), style: "winsColumn"),
            grid.Column("Outcome", format: (item) => Html.Raw(item.Symbols), style:"symbolsColumn")
