@using GameHistory.Helpers
@model GameHistory.Models.GameHistoryGameInfoModel

@{
    ViewBag.Title = "Index";
}

<style type="text/css">

    .header-style {
        padding-bottom: 1px;
        padding-top: 1px;
        text-align: center;

    }
    .row-style {
        padding-bottom: 4px;
        padding-top: 5px;
        text-align: center;
    }

    .alt {
        text-align: center;
        background-color: #DAEEF3; 
    }
    h3 {
        padding-bottom: 1px;
        padding-top: 1px;
        text-align: center;
    }
</style>



@helper getBetPerLine(decimal totalBet, decimal linesPlayed) {
    decimal betPerLine = totalBet / linesPlayed;    
    @betPerLine
    }

<div id="btnClose" onclick="closePopUp();"><img src="~/Content/Images/CloseButton.png"></div>

@*<b>Lines Played:    </b>         @Model.UserPositions.SlotUsersPositionsAndDetails.SlotDetails.SlotDetails[0].Position
    <b>Bet Per Line:    </b>        @getBetPerLine(Convert.ToDecimal(@Model.GameHistoryGameInfoSlotModel.Bet), Convert.ToDecimal(@Model.UserPositions.SlotUsersPositionsAndDetails.SlotDetails.SlotDetails[0].Position))
    <br />*@
<b>GameId:        </b>         @Model.GameHistoryGameInfoSlotModel.GameId

    @*<b>GameIdentifier:</b> @Model.GameHistoryGameInfoSlotModel.GameIdentifier       <br />
    <b>GameName: </b>      @Model.GameHistoryGameInfoSlotModel.GameName             <br />*@
