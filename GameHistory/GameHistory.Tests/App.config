<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Test-only configuration for GameHistory.Tests. This is entirely separate from the GameHistory web app's
    Web.config: MSBuild transforms this into GameHistory.Tests.dll.config and only that file is loaded into the
    test process, so changes to the app's Web.config never affect the tests (and vice versa).

    These appSettings are the defaults the PrepareContext/TryCreate tests start from; each such test overrides the
    keys it needs at runtime via ConfigurationManager.AppSettings.Set(...), so the values here are just a safe,
    feature-off baseline.
  -->
  <appSettings>
    <add key="MultiplierRecompute.Enabled" value="false" />
    <add key="MultiplierRecompute.GameConfigRoot" value="" />
    <add key="MultiplierRecompute.GateOverlayOnRecordedWin" value="false" />
  </appSettings>
</configuration>
